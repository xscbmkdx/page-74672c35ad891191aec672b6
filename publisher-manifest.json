om:12px;border-bottom:1px solid var(--line)}\n  thead th.plan-col{color:var(--ink);letter-spacing:.05em}\n  tbody th{font-weight:600;width:150px;color:var(--ink-soft);font-size:.82rem}\n  td.price{font-size:1.35rem;font-weight:800;letter-spacing:-.01em;line-height:1.3}\n  td.price small{display:block;font-size:.74rem;font-weight:400;letter-spacing:.02em;color:var(--ink-mute);margin-top:4px}\n  .featured{background:var(--paper-soft)}\n  table .featured{background:var(--paper-soft)}\n  .tag{display:inline-block;margin-left:8px;padding:0 7px;font-size:.68rem;letter-spacing:.1em;background:var(--neon);color:var(--ink);vertical-align:2px}\n  td ul{margin:0;padding-left:1.05em;color:var(--ink-soft)}\n  td ul li{margin:2px 0}\n\n  .devices{display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(28px,4vw,56px);max-width:62rem}\n  .devices article p{margin-top:10px;color:var(--ink-soft);font-size:.94rem;max-width:34rem}\n  .devices ul{margin-top:12px;color:var(--ink-soft);font-size:.92rem}\n  .devices ul li{margin:5px 0}\n\n  .faq-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(24px,3.2vw,44px) clamp(32px,4vw,64px)}\n  .qa{border-top:1px solid var(--line-strong);padding-top:16px}\n  .qa h3{display:grid;grid-template-columns:auto minmax(0,1fr);gap:10px;font-size:.98rem;line-height:1.6}\n  .qa h3 span{font-size:.72rem;letter-spacing:.12em;color:var(--ink-mute);font-weight:600;padding-top:4px}\n  .qa p{margin-top:8px;padding-left:26px;font-size:.9rem;color:var(--ink-soft)}\n\n  .closing{display:grid;grid-template-columns:minmax(0,1fr);gap:22px;max-width:40rem}\n  .closing p{color:var(--ink-soft);font-size:.94rem}\n  .closing .back{font-size:.84rem;text-decoration:none;border-bottom:2px solid var(--neon);justify-self:start}\n\n  footer{border-top:1px solid var(--line-strong);background:var(--paper-soft)}\n  .foot-inner{max-width:1240px;margin:0 auto;padding:28px var(--pad) 40px;display:flex;flex-wrap:wrap;gap:8px 32px;font-size:.78rem;color:var(--ink-mute);letter-spacing:.02em}\n  .foot-inner .mark{color:var(--ink);font-weight:700;letter-spacing:.18em;text-transform:uppercase}\n\n  @media (min-width:720px){\n    .steps{grid-template-columns:repeat(2,minmax(0,1fr))}\n    .faq-grid{grid-template-columns:repeat(2,minmax(0,1fr))}\n    .devices{grid-template-columns:repeat(2,minmax(0,1fr))}\n    .hero .narrow{max-width:36rem}\n    .sec-head{grid-template-columns:minmax(0,1fr)}\n  }\n  @media (min-width:980px){\n    .hero{grid-template-columns:minmax(0,1fr)}\n    .hero .narrow{max-width:38rem}\n  }\n</style><header class=\"topbar\">\n  <div class=\"topbar-inner\">\n    <div class=\"mark\">WeGo<span>说明书</span></div>\n    <nav aria-label=\"页面目录\">\n      <a href=\"#plans\">订阅计划</a>\n      <a href=\"#howto\">使用步骤</a>\n      <a href=\"#clients\">设备与客户端</a>\n      <a href=\"#faq\">常见问题</a>\n    </nav>\n    <div class=\"stamp\">文档编号 7710</div>\n  </div>\n</header>\n\n<main>\n\n  <section class=\"hero\">\n    <div class=\"narrow\">\n      <p class=\"eyebrow\">WeGo · 阅读前须知</p>\n      <h1 id=\"hero-title\">关于 <em>WeGo</em> 的三档订阅与手边须知</h1>\n      <p class=\"lede\">这份页面只做一件事：把 WeGo 的订阅档位、设备数量、使用顺序和常见疑问按条目写清楚。你可以在下单前逐项核对，也可以把它当作续费前的对照表。</p>\n      <div class=\"meta-strip\">\n        <div><strong>3 档</strong>订阅计划</div>\n        <div><strong>3 / 5 / 20 台</strong>设备数量上限</div>\n        <div><strong>100GB 起</strong>每月流量额度</div>\n      </div>\n      <p class=\"jump\">\n        <a href=\"#plans\">直接看套餐对比 →</a>\n        <a href=\"#faq\">跳到常见问题 →</a>\n      </p>\n    </div>\n  </section>\n\n  <section id=\"plans\">\n    <div class=\"sec-head\">\n      <p class=\"idx\">01 / 订阅计划</p>\n      <h2 id=\"plans-title\">三档订阅横向对照</h2>\n      <p>同一张表里并列三项：流量额度、设备数量、线路与支持。所有价格均为展示价，实际结算以你下单时页面显示为准。年付价格按单月折算，不包含其他未列明的附加费用。</p>\n    </div>\n\n    <div class=\"table-wrap\">\n      <table>\n        表内数值来自 WeGo 现有档位说明；未列出的项目视为该档位不包含。\n        <thead>\n          <tr>\n            <th>对照项</th>\n            <th class=\"plan-col\">基础版</th>\n            <th class=\"plan-col\">旗舰版<span class=\"tag\">推荐</span></th>\n            <th class=\"plan-col\">团队版</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr>\n            <th>月付价格</th>\n            <td class=\"price\">¥15<small>每 月</small></td>\n            <td class=\"price featured\">¥35<small>每 月</small></td>\n            <td class=\"price\">¥85<small>每 月</small></td>\n          </tr>\n          <tr>\n            <th>年付价格</th>\n            <td>¥150 / 年</td>\n            <td class=\"featured\">¥350 / 年</td>\n            <td>¥850 / 年</td>\n          </tr>\n          <tr>\n            <th>每月流量</th>\n            <td>100GB</td>\n            <td class=\"featured\">300GB</td>\n            <td>1000GB</td>\n          </tr>\n          <tr>\n            <th>同时在线设备</th>\n            <td>3 台</td>\n            <td class=\"featured\">5 台</td>\n            <td>20 台</td>\n          </tr>\n          <tr>\n            <th>线路</th>\n            <td>普通线路节点池</td>\n            <td class=\"featured\">IPLC 专线，针对游戏场景做优化</td>\n            <td>VIP 专属高带宽节点</td>\n          </tr>\n          <tr>\n            <th>流媒体</th>\n            <td>支持基础流媒体</td>\n            <td class=\"featured\">全节点原生流媒体解锁</td>\n            <td>全节点原生流媒体解锁</td>\n          </tr>\n          <tr>\n            <th>支持方式</th>\n            <td>常规工单</td>\n            <td class=\"featured\">7×24 优先工单</td>\n            <td>专属客户经理</td>\n          </tr>\n          <tr>\n            <th>其他</th>\n            <td>—</td>\n            <td class=\"featured\">—</td>\n            <td>\n              <ul>\n                <li>企业定制路由</li>\n              </ul>\n            </td>\n          </tr>\n          <tr>\n            <th>适合谁</th>\n            <td>单人或两人使用，流量需求平稳。</td>\n            <td class=\"featured\">家庭或小团队，需要更多设备与更低延迟。</td>\n            <td>多人协作，需要固定带宽与单独对接人。</td>\n          </tr>\n        </tbody>\n      </table>\n    </div>\n  </section>\n\n  <section id=\"howto\">\n    <div class=\"sec-head\">\n      <p class=\"idx\">02 / 使用步骤</p>\n      <h2 id=\"howto-title\">从下单到日常使用，按顺序做四步</h2>\n      <p>以下步骤按操作先后排列。每一步只做一件事，做完再进入下一步，可以减少配置反复。</p>\n    </div>\n\n    <div class=\"steps\">\n      <div class=\"step\">\n        <div class=\"num\">01</div>\n        <div>\n          <h3>先确定档位，不要先装客户端</h3>\n          <p>对照上表，先看你需要的设备数量与每月流量，再看是否需要专线或企业定制路由。档位确定后再进入配置环节，避免装好客户端才发现设备数不够用。</p>\n          <p class=\"note\">同一时间在线的设备数是硬性上限，超出后需要先下线一台。</p>\n        </div>\n      </div>\n      <div class=\"step\">\n        <div class=\"num\">02</div>\n        <div>\n          <h3>在账户内查看订阅状态</h3>\n          <p>登录后确认当前档位、生效时间与本月已用流量。若你是从低档位升级，请先核对升级后的计费方式与剩余周期处理规则，再决定是否变更。</p>\n          <p class=\"note\">页面不提供下载地址；客户端获取方式以账户内说明为准。</p>\n        </div>\n      </div>\n      <div class=\"step\">\n        <div class=\"num\">03</div>\n        <div>\n          <h3>按设备类型分别配置</h3>\n          <p>手机、电脑、平板各有对应的配置方式，按设备逐个完成，不要在多台设备上混用同一份配置信息。每完成一台，先确认能正常使用，再继续下一台。</p>\n          <p class=\"note\">团队版如需定制路由，请通过专属客户经理提交，不要自行修改默认参数。</p>\n        </div>\n      </div>\n      <div class=\"step\">\n        <div class=\"num\">04</div>\n        <div>\n          <h3>记录流量，按周期复核档位</h3>\n          <p>每月中旬查看一次已用流量，判断当前额度是否明显不够或长期闲置。连续两个月接近上限，再考虑升档；长期不足三成，可以降档。</p>\n          <p class=\"note\">档位变更的具体生效规则以账户内条款为准，此处不作承诺。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"clients\">\n    <div class=\"sec-head\">\n      <p class=\"idx\">03 / 设备与客户端</p>\n      <h2 id=\"clients-title\">设备数量怎么算，配置怎么放</h2>\n      <p>这一节只说明设备数量的计算口径与配置管理方式，不提供具体下载入口。</p>\n    </div>\n\n    <div class=\"devices\">\n      <article>\n        <h3>设备数量的计算口径</h3>\n        <p>设备数量指同一时间保持在线并占用线路的设备总数，而不是历史登录过的设备总数。基础版 3 台、旗舰版 5 台、团队版 20 台。换设备时先退出旧设备，可以继续使用同一个名额。</p>\n        <ul>\n          <li>手机与电脑分别计为独立设备。</li>\n          <li>同一台设备上的多个客户端通常只计一次，具体以账户显示为准。</li>\n          <li>名额被占满时，新设备无法同时在线，需先下线一台。</li>\n        </ul>\n      </article>\n      <article>\n        <h3>配置信息的保存方式</h3>\n        <p>配置信息与账户绑定，请只在自己的设备上使用。不要把配置信息转交他人，否则会导致设备名额被占用，也可能触发票据与账户方面的处理。</p>\n        <ul>\n          <li>每台设备单独保存一份，避免覆盖同一份文件。</li>\n          <li>更换设备前先完成旧设备的退出操作。</li>\n          <li>配置异常时，先在账户内核对状态，再联系支持。</li>\n        </ul>\n      </article>\n      <article>\n        <h3>支持渠道与响应顺序</h3>\n        <p>基础版使用常规工单；旗舰版为 7×24 优先工单；团队版配有专属客户经理。提交问题时，请写明设备类型、当前档位与出现问题的具体环节，便于一次性定位。</p>\n        <ul>\n          <li>先自查：账户状态、设备数量、本月流量。</li>\n          <li>再提单：附上问题发生时间与操作步骤。</li>\n          <li>团队版定制需求，走客户经理渠道统一登记。</li>\n        </ul>\n      </article>\n      <article>\n        <h3>关于下载与安装</h3>\n        <p>本页面不提供客户端下载地址，也不提供任何第三方安装包。请以账户内说明的获取方式为准；来源不明的安装包不要运行。</p>\n        <ul>\n          <li>不通过他人转发的链接安装客户端。</li>\n          <li>安装前确认设备系统版本，避免安装后无法启动。</li>\n          <li>遇到安装问题，按支持渠道提交，不要重复安装覆盖。</li>\n        </ul>\n      </article>\n    </div>\n  </section>\n\n  <section id=\"faq\">\n    <div class=\"sec-head\">\n      <p class=\"idx\">04 / 常见问题</p>\n      <h2 id=\"faq-title\">常见问题双栏问答</h2>\n      <p>以下问题按提问频率排列，左侧偏购买与计费，右侧偏使用与设备。</p>\n    </div>\n\n    <div class=\"faq-grid\">\n      <div class=\"qa\">\n        <h3><span>Q1</span>三个档位的主要差别是什么？</h3>\n        <p>差别集中在三处：每月流量额度（100GB / 300GB / 1000GB）、同时在线设备数（3 / 5 / 20 台）、线路与支持等级。旗舰版额外包含 IPLC 专线与优先工单，团队版额外包含 VIP 高带宽节点、企业定制路由与专属客户经理。</p>\n      </div>\n      <div class=\"qa\">\n        <h3><span>Q2</span>年付比月付能省多少？</h3>\n        <p>以展示价计算，基础版年付 ¥150，相当于十个月月费；旗舰版 ¥350，团队版 ¥850，折算方式相同。是否选择年付，建议先按月付使用一个完整周期，确认流量与设备需求后再决定。</p>\n      </div>\n      <div class=\"qa\">\n        <h3><span>Q3</span>流量用完后会怎样？</h3>\n        <p>本页面不描述流量耗尽后的具体处理方式，因为这取决于你下单时确认的条款。建议在月中查看一次用量，接近上限时提前决定升档或等待下一个计费周期，而不是等到无法使用再处理。</p>\n      </div>\n      <div class=\"qa\">\n        <h3><span>Q4</span>可以中途升级或降档吗？</h3>\n        <p>账户内提供档位变更入口，但计费差额与生效时间按当时条款执行，本页面不作承诺。变更前请先确认剩余周期如何处理，再提交操作。团队版涉及定制路由时，变更前请先与客户经理沟通。</p>\n      </div>\n      <div class=\"qa\">\n        <h3><span>Q5</span>设备数量是累计还是同时？</h3>\n        <p>是同时在线数量，不是历史累计。也就是说，你在多台设备上登录过不会持续占用名额，只要同一时间在线的设备不超过档位上限即可。换机时先退出旧设备，就能继续使用同一名额。</p>\n      </div>\n      <div class=\"qa\">\n        <h3><span>Q6</span>在哪里获取客户端？</h3>\n        <p>本页面不提供下载地址，也不推荐任何第三方安装包。请在登录账户后按账户内说明获取。若说明中没有你设备对应的版本，请通过支持渠道询问，不要从转发链接安装。</p>\n      </div>\n      <div class=\"qa\">\n        <h3><span>Q7</span>遇到问题该找谁？</h3>\n        <p>基础版提交常规工单；旗舰版使用 7×24 优先工单；团队版联系专属客户经理。提交时写清设备类型、当前档位和出问题的具体步骤，比只写“不能用”更容易一次解决。</p>\n      </div>\n      <div class=\"qa\">\n        <h3><span>Q8</span>团队版的企业定制路由是什么？</h3>\n        <p>它是为多人协作场景准备的定制选项，具体可用范围和实现方式需与专属客户经理确认。本页面不展开技术细节，也不承诺任何特定线路或性能表现。有需求时请先登记场景，再评估是否适合。</p>\n      </div>\n    </div>\n  </section>\n\n  <section>\n    <div class=\"closing\">\n      <p class=\"idx\">05 / 小结</p>\n      <h2 id=\"closing-title\">先核对，再决定</h2>\n      <p>如果你只需要单人使用，基础版的三台设备与 100GB 月流量通常够用；设备多、对延迟敏感，再考虑旗舰版；多人共用并需要单独对接人时，团队版更合适。所有价格与权益以本页表格和下单页面为准，本页不构成额外承诺。</p>\n      <a class=\"back\" href=\"#plans\">回到订阅对照表 ↑</a>\n    </div>\n  </section>\n\n</main>\n\n<footer>\n  <div class=\"foot-inner\">\n    <span class=\"mark\">WeGo</span>\n    <span>页面性质：使用说明与档位对照</span>\n    <span>文档编号 7710</span>\n    <span>价格与权益以下单页面显示为准</span>\n  </div>\n</footer>",
